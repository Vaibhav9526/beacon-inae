# Copy to .env and export these before `npm start` (the server reads process.env).
PORT=8787
BEACON_DATA=./data                  # sqlite db, uploaded media and the server's signing key live here
MOD_TOKEN=change-me                 # enables /mod and /v1/mod/*; leave empty to disable moderator endpoints
ANTHROPIC_API_KEY=                  # optional: AI pre-screening of reports (claude-opus-5-5); empty = everything goes to moderators
FIREBASE_SERVICE_ACCOUNT=           # optional: path to a Firebase service-account JSON for real FCM push; empty = push is logged only
PUBLIC_URL=                          # https address the internet reaches this server at, e.g. https://beacon.onrender.com. Render sets RENDER_EXTERNAL_URL itself; set this only on other hosts. Needed for the Telegram bot webhook.
